# TrueForge on localhost (required for the judged job)
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
# TRUEFORGE_MODEL=openai/gpt-4o-mini
# TRUEFORGE_TOKEN=

# Connector names from TrueForge Settings → Connectors
# Default match: names containing "search" / "web" and "slack"
TRUEFORGE_MCP_SEARCH=web-search
TRUEFORGE_MCP_WRITE=slack

# Overlay only (Finder grants / harness down). Not used by the filmed job.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=

# Unsigned full_access / host shell stay off unless you set this
# PETASSIST_ALLOW_FULL_ACCESS=1

# Optional if you keep the local slack_post overlay
# SLACK_WEBHOOK_URL=
